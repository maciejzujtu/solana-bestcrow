NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Used if the configured endpoint is invalid or points at another cluster.
NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URL=https://api.devnet.solana.com
# Wallet Standard chain: 'solana:devnet' (default) or 'solana:localnet' for a
# local validator/surfnet. Only wallets advertising the chain can connect.
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
# Keep the creation mock enabled for UI mockups until ProtocolConfigV2 is deployed.
# Set to false to require the real on-chain config account.
NEXT_PUBLIC_ENABLE_DEVNET_MOCKS=true
# Public Devnet RPCs are rate-limited. Prefer a dedicated provider for regular use.
NEXT_PUBLIC_SOLANA_RPC_RETRY_ATTEMPTS=3
NEXT_PUBLIC_SOLANA_RPC_RETRY_BASE_DELAY_MS=250
# Program IDs. Use bestcrow for the target MVP; charity_vault is the legacy demo.
NEXT_PUBLIC_CHARITY_VAULT_PROGRAM_ID=74GsU9xRv9qvVHXXvTAAmRp8ETTEAwGjV1UkJQ6BZNpG
NEXT_PUBLIC_BESTCROW_PROGRAM_ID=3jGgPRa4gH25wfL49E3TAtpix5ePUZKWrQLT83eNZBVr
