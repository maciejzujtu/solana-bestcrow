FROM node:22.16.0-alpine@sha256:41e4389f3d988d2ed55392df4db1420ad048ae53324a8e2b7c6d19508288107e

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit
COPY . .
ARG NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
ENV NEXT_PUBLIC_SOLANA_RPC_URL=${NEXT_PUBLIC_SOLANA_RPC_URL}
ARG NEXT_PUBLIC_BESTCROW_PROGRAM_ID=EousWVK2cePYb9zvv1oWSca4VNdRQqYef8CsxQ6BL57R
ENV NEXT_PUBLIC_BESTCROW_PROGRAM_ID=${NEXT_PUBLIC_BESTCROW_PROGRAM_ID}
ARG NEXT_PUBLIC_USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
ENV NEXT_PUBLIC_USDC_MINT=${NEXT_PUBLIC_USDC_MINT}
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build
RUN chown -R node:node /app/.next

ENV NODE_ENV=production
ENV PORT=3000
USER node
EXPOSE 3000
CMD ["npm", "start"]
