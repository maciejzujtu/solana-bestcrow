# Copy to .env only when you need to override Compose defaults.
# The frontend RPC URL is visible in the browser. Do not put secrets in it.
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Used if the configured endpoint is invalid or points at another cluster.
NEXT_PUBLIC_SOLANA_RPC_FALLBACK_URL=https://api.devnet.solana.com
# Wallet Standard chain for the frontend: 'solana:devnet' or 'solana:localnet'.
NEXT_PUBLIC_SOLANA_CHAIN=solana:devnet
# Program IDs. Use bestcrow for the target MVP; charity_vault is the legacy demo.
CHARITY_VAULT_PROGRAM_ID=74GsU9xRv9qvVHXXvTAAmRp8ETTEAwGjV1UkJQ6BZNpG
BESTCROW_PROGRAM_ID=3jGgPRa4gH25wfL49E3TAtpix5ePUZKWrQLT83eNZBVr
# RPC retry for rate-limited public endpoints.
RPC_RETRY_ATTEMPTS=3
RPC_RETRY_BASE_DELAY_MS=250
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
INDEXER_ENABLED=true
POLL_INTERVAL_MS=15000
SIGNATURE_SCAN_LIMIT=200
APP_ORIGIN=http://localhost:3000
SESSION_TTL_SECONDS=86400
WALLET_CHALLENGE_TTL_SECONDS=300
AUTH_ATTEMPTS_PER_MINUTE=20
